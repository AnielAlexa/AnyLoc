# Dockerfile for AnyLoc Drone Navigation on Jetson Orin Nano
# Optimized for real-time GPS-free navigation with vitl14 + FAISS

# Use NVIDIA L4T PyTorch base image for Jetson
FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_DEVICE_ORDER=PCI_BUS_ID

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build tools
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    # Computer vision libraries
    libopencv-dev \
    python3-opencv \
    # Math and science libraries
    libopenblas-dev \
    liblapack-dev \
    libeigen3-dev \
    # Graphics and display
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # Networking
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt/anyloc

# Copy requirements first for better caching
COPY requirements.jetson.txt /opt/anyloc/
COPY setup_jetson_env.sh /opt/anyloc/

# Install Python dependencies optimized for Jetson
RUN pip3 install --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir -r requirements.jetson.txt

# Install FAISS for ARM64/CUDA (Jetson optimized)
RUN pip3 install --no-cache-dir faiss-gpu

# Copy AnyLoc source code
COPY utilities.py /opt/anyloc/
COPY configs.py /opt/anyloc/
COPY custom_datasets/ /opt/anyloc/custom_datasets/
COPY realtime_drone_matching.py /opt/anyloc/
COPY faiss_optimized_matching.py /opt/anyloc/
COPY offline_vs_realtime_processing.py /opt/anyloc/

# Copy optimized drone navigation scripts
COPY jetson_drone_navigation.py /opt/anyloc/
COPY jetson_deployment_manager.py /opt/anyloc/

# Create directories for mission data
RUN mkdir -p /opt/anyloc/missions && \
    mkdir -p /opt/anyloc/cache && \
    mkdir -p /opt/anyloc/logs && \
    mkdir -p /opt/anyloc/config

# Set up permissions
RUN chmod +x /opt/anyloc/setup_jetson_env.sh

# Install DINOv2 models (download once, use forever)
RUN python3 -c "import torch; torch.hub.load('facebookresearch/dinov2', 'dinov2_vitl14')"

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash drone && \
    chown -R drone:drone /opt/anyloc

USER drone

# Expose ports for communication
EXPOSE 8080 8081 8082

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import torch; print('CUDA available:', torch.cuda.is_available())" || exit 1

# Default command
CMD ["python3", "jetson_drone_navigation.py", "--config", "/opt/anyloc/config/mission.yaml"]